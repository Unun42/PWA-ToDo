PORT=3001
CORS_ORIGIN=http://localhost:5173

# Turso: get these from `turso db show <name> --url` and `turso db tokens create <name>`
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-token-here

# No Turso account? A local SQLite file works too (leave TURSO_AUTH_TOKEN empty):
# TURSO_DATABASE_URL=file:todos.db
