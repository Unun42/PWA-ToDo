PORT=3001
CORS_ORIGIN=http://localhost:5173

# Local development: todos are stored in a SQLite file in this folder.
TURSO_DATABASE_URL=file:todos.db

# Turso instead: get these from `turso db show <name> --url` and
# `turso db tokens create <name>`.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-token-here
