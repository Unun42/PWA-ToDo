# Local dev (better-sqlite3) — leave TURSO_* unset to use this path
PORT=3001
DB_PATH=./data/todos.db
CORS_ORIGIN=http://localhost:5173

# Production (Turso) — setting TURSO_DATABASE_URL switches src/db/index.js
# to the libSQL driver automatically. Get these from `turso db show` / `turso db tokens create`.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-token-here
